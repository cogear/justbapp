{% comment %}
  Cart Drawer - Slide-out cart
{% endcomment %}

<div class="cart-drawer__header">
  <h2 class="cart-drawer__title">Your Cart</h2>
  <button type="button" class="cart-drawer__close" data-cart-close>
    ×
  </button>
</div>

<div class="cart-drawer__items" data-cart-items>
  {% if cart.item_count > 0 %}
    {% for item in cart.items %}
      <div class="cart-item" data-cart-item="{{ item.key }}">
        <div style="display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border);">
          <div style="width: 80px; height: 80px; border-radius: var(--radius-md); overflow: hidden; flex-shrink: 0;">
            {% if item.image %}
              <img
                src="{{ item.image | image_url: width: 160 }}"
                alt="{{ item.image.alt | escape }}"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {% endif %}
          </div>
          
          <div style="flex: 1;">
            <h3 style="font-size: 1rem; margin-bottom: 0.25rem;">
              <a href="{{ item.url }}" style="color: var(--color-foreground);">
                {{ item.product.title }}
              </a>
            </h3>
            
            {% if item.variant.title != 'Default Title' %}
              <p style="font-size: 0.875rem; color: var(--color-muted-foreground); margin-bottom: 0.5rem;">
                {{ item.variant.title }}
              </p>
            {% endif %}
            
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <button
                  type="button"
                  class="cart-item__qty-btn"
                  data-cart-update="{{ item.key }}"
                  data-qty="{{ item.quantity | minus: 1 }}"
                  style="width: 28px; height: 28px; border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-background); cursor: pointer;"
                >
                  −
                </button>
                <span style="min-width: 2rem; text-align: center;">{{ item.quantity }}</span>
                <button
                  type="button"
                  class="cart-item__qty-btn"
                  data-cart-update="{{ item.key }}"
                  data-qty="{{ item.quantity | plus: 1 }}"
                  style="width: 28px; height: 28px; border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-background); cursor: pointer;"
                >
                  +
                </button>
              </div>
              
              <p style="font-weight: 600; color: var(--color-primary);">
                {{ item.final_line_price | money }}
              </p>
            </div>
          </div>
          
          <button
            type="button"
            class="cart-item__remove"
            data-cart-update="{{ item.key }}"
            data-qty="0"
            style="background: none; border: none; color: var(--color-muted-foreground); cursor: pointer; padding: 0.25rem;"
          >
            ×
          </button>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div style="text-align: center; padding: 3rem 1rem;">
      <p class="text-muted">Your cart is empty</p>
    </div>
  {% endif %}
</div>

{% if cart.item_count > 0 %}
  <div class="cart-drawer__footer">
    <div class="cart-drawer__total">
      <span>Subtotal</span>
      <span data-cart-total>{{ cart.total_price | money }}</span>
    </div>
    
    <p style="font-size: 0.875rem; color: var(--color-muted-foreground); margin-bottom: 1rem; text-align: center;">
      Shipping calculated at checkout
    </p>
    
    <a href="{{ routes.cart_url }}" class="btn btn--secondary" style="width: 100%; margin-bottom: 0.5rem;">
      View Cart
    </a>
    
    <button
      type="button"
      onclick="window.location.href='{{ routes.checkout_url }}'"
      class="btn btn--primary"
      style="width: 100%;"
    >
      Checkout
    </button>
  </div>
{% endif %}
