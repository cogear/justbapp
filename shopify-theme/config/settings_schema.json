                "min": 1200,
                "max": 1600,
                "step": 50,
                "unit": "px",
                "default": 1536
            },
            {
                "type": "range",
                "id": "border_radius",
                "label": "Border Radius",
                "min": 0,
                "max": 50,
                "step": 2,
                "unit": "px",
                "default": 48,
                "info": "Rounded corners for cards and buttons"
            }
        ]
