            },
            {
                "type": "range",
                "id": "font_size_base",
                "label": "Base Font Size",
                "min": 14,
                "max": 20,
                "step": 1,
                "unit": "px",
                "default": 16
            }
        ]
    },
    {
        "name": "Layout",
        "settings": [
            {
                "type": "header",
                "content": "Layout Settings"
            },
            {
                "type": "range",
                "id": "layout_max_width",
