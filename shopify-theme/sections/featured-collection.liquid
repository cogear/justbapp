{% comment %}
  Featured Collection Section
{% endcomment %}

<section class="section">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="text-center mb-xl {% if section.settings.handwritten_title %}handwritten-large{% endif %}" style="font-size: {% if section.settings.handwritten_title %}3rem{% else %}2.5rem{% endif %};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="text-center text-muted mb-xl" style="max-width: 42rem; margin-left: auto; margin-right: auto; font-size: 1.125rem;">
        {{ section.settings.description }}
      </p>
    {% endif %}

    <div class="product-grid">
      {% for product in collections[section.settings.collection].products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-card__image">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                        {{ product.featured_image | image_url: width: 600 }} 600w,
                        {{ product.featured_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
              >
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          
          <div class="product-card__content">
            <h3 class="product-card__title">
              {{ product.title }}
            </h3>
            
            <div class="product-card__price">
              {% if product.compare_at_price > product.price %}
                <span style="text-decoration: line-through; color: var(--color-muted-foreground); margin-right: 0.5rem;">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
              <span>{{ product.price | money }}</span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="text-center mt-xl">
        <a href="{{ collections[section.settings.collection].url }}" class="btn btn--primary">
          View All
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "handwritten_title",
      "label": "Use handwritten font for title",
      "default": false,
      "info": "Adds a warm, personal touch"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
