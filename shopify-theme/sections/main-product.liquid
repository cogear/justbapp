{% comment %}
  Product Template - Main product page
{% endcomment %}

<div class="section">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr; gap: 3rem; margin-bottom: 3rem;">
      {% if product.images.size > 0 %}
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start;">
          {%- comment -%} Product Images {%- endcomment -%}
          <div>
            <div style="position: sticky; top: 6rem;">
              <div id="product-images" style="border-radius: var(--radius-xl); overflow: hidden; background-color: var(--color-secondary);">
                {% for image in product.images %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    srcset="{{ image | image_url: width: 400 }} 400w,
                            {{ image | image_url: width: 800 }} 800w,
                            {{ image | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 768px) 50vw, 100vw"
                    alt="{{ image.alt | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    style="width: 100%; height: auto; display: {% if forloop.first %}block{% else %}none{% endif %};"
                    data-image-index="{{ forloop.index0 }}"
                  >
                {% endfor %}
              </div>

              {% if product.images.size > 1 %}
                <div style="display: flex; gap: 0.75rem; margin-top: 1rem; overflow-x: auto;">
                  {% for image in product.images %}
                    <button
                      type="button"
                      onclick="showProductImage({{ forloop.index0 }})"
                      style="width: 80px; height: 80px; border-radius: var(--radius-md); overflow: hidden; border: 2px solid {% if forloop.first %}var(--color-primary){% else %}transparent{% endif %}; cursor: pointer; flex-shrink: 0; background: none; padding: 0;"
                      data-thumbnail="{{ forloop.index0 }}"
                    >
                      <img
                        src="{{ image | image_url: width: 160 }}"
                        alt="{{ image.alt | escape }}"
                        style="width: 100%; height: 100%; object-fit: cover;"
                      >
                    </button>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>

          {%- comment -%} Product Info {%- endcomment -%}
          <div>
            <h1 class="mb-sm" style="font-size: 2.5rem;">
              {{ product.title }}
            </h1>

            <div class="mb-md" style="font-size: 1.5rem; font-weight: 600; color: var(--color-primary);">
              <span id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
              {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                <span style="text-decoration: line-through; color: var(--color-muted-foreground); font-size: 1.25rem; margin-left: 0.5rem;">
                  {{ product.selected_or_first_available_variant.compare_at_price | money }}
                </span>
              {% endif %}
            </div>

            {% if product.description != blank %}
              <div class="mb-lg text-muted" style="font-size: 1.125rem; line-height: 1.6;">
                {{ product.description }}
              </div>
            {% endif %}

            {% form 'product', product %}
              {% if product.variants.size > 1 %}
                <div class="mb-md">
                  {% for option in product.options_with_values %}
                    <div class="mb-sm">
                      <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
                        {{ option.name }}
                      </label>
                      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        {% for value in option.values %}
                          <input
                            type="radio"
                            id="{{ option.name }}-{{ value | handle }}"
                            name="options[{{ option.name }}]"
                            value="{{ value }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            style="display: none;"
                          >
                          <label
                            for="{{ option.name }}-{{ value | handle }}"
                            style="padding: 0.75rem 1.5rem; border: 2px solid var(--color-border); border-radius: var(--radius-full); cursor: pointer; transition: all var(--transition-fast);"
                          >
                            {{ value }}
                          </label>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              <select name="id" style="display: none;">
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>

              <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem;">
                <label style="font-weight: 600;">Quantity:</label>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <button
                    type="button"
                    onclick="updateQuantity(-1)"
                    style="width: 40px; height: 40px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-background); cursor: pointer; font-size: 1.25rem;"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    name="quantity"
                    id="quantity"
                    value="1"
                    min="1"
                    style="width: 60px; height: 40px; text-align: center; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-background); color: var(--color-foreground);"
                  >
                  <button
                    type="button"
                    onclick="updateQuantity(1)"
                    style="width: 40px; height: 40px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-background); cursor: pointer; font-size: 1.25rem;"
                  >
                    +
                  </button>
                </div>
              </div>

              <button
                type="submit"
                class="btn btn--primary btn--large"
                style="width: 100%;"
                {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
              >
                {% if product.selected_or_first_available_variant.available %}
                  Add to Cart
                {% else %}
                  Sold Out
                {% endif %}
              </button>
            {% endform %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function showProductImage(index) {
    const images = document.querySelectorAll('[data-image-index]');
    const thumbnails = document.querySelectorAll('[data-thumbnail]');
    
    images.forEach((img, i) => {
      img.style.display = i === index ? 'block' : 'none';
    });
    
    thumbnails.forEach((thumb, i) => {
      thumb.style.borderColor = i === index ? 'var(--color-primary)' : 'transparent';
    });
  }

  function updateQuantity(change) {
    const input = document.getElementById('quantity');
    const newValue = parseInt(input.value) + change;
    if (newValue >= 1) {
      input.value = newValue;
    }
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
