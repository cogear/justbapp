{% comment %}
  Text with Image Section - Alternating layout like b. principles
{% endcomment %}

<section class="section" style="background-color: {% if section.settings.background_color %}{{ section.settings.background_color }}{% else %}rgba(224, 230, 230, 0.3){% endif %};">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center;">
      {% if section.settings.layout == 'image_left' %}
        <div style="grid-column: 1; {% if section.settings.image != blank %}display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;{% endif %}">
          {% if section.settings.image != blank %}
            <div style="border-radius: var(--radius-xl); overflow: hidden;">
              <img
                src="{{ section.settings.image | image_url: width: 800 }}"
                srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                        {{ section.settings.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 768px) 50vw, 100vw"
                alt="{{ section.settings.image.alt | escape }}"
                loading="lazy"
                style="width: 100%; height: auto; display: block;"
              >
            </div>
          {% endif %}
          
          <div>
            {% if section.settings.title != blank %}
              <h2 class="mb-md" style="font-size: 2rem;">
                {{ section.settings.title }}
              </h2>
            {% endif %}
            
            {% if section.settings.text != blank %}
              <div class="text-muted" style="font-size: 1.125rem; line-height: 1.6;">
                {{ section.settings.text }}
              </div>
            {% endif %}
            
            {% if section.settings.button_text != blank %}
              <div class="mt-md">
                <a href="{{ section.settings.button_link }}" class="btn btn--primary">
                  {{ section.settings.button_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div style="grid-column: 1; {% if section.settings.image != blank %}display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;{% endif %}">
          <div>
            {% if section.settings.title != blank %}
              <h2 class="mb-md" style="font-size: 2rem;">
                {{ section.settings.title }}
              </h2>
            {% endif %}
            
            {% if section.settings.text != blank %}
              <div class="text-muted" style="font-size: 1.125rem; line-height: 1.6;">
                {{ section.settings.text }}
              </div>
            {% endif %}
            
            {% if section.settings.button_text != blank %}
              <div class="mt-md">
                <a href="{{ section.settings.button_link }}" class="btn btn--primary">
                  {{ section.settings.button_text }}
                </a>
              </div>
            {% endif %}
          </div>
          
          {% if section.settings.image != blank %}
            <div style="border-radius: var(--radius-xl); overflow: hidden;">
              <img
                src="{{ section.settings.image | image_url: width: 800 }}"
                srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                        {{ section.settings.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 768px) 50vw, 100vw"
                alt="{{ section.settings.image.alt | escape }}"
                loading="lazy"
                style="width: 100%; height: auto; display: block;"
              >
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text with Image",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_left",
          "label": "Image Left"
        },
        {
          "value": "image_right",
          "label": "Image Right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "About b."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>In a world obsessed with doing, we invite you to simply be.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    }
  ],
  "presets": [
    {
      "name": "Text with Image"
    }
  ]
}
{% endschema %}
