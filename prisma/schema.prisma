generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  displayName            String?
  isPhantom              Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  psychographicProfile   String?
  memoryVector           Unsupported("vector")?
  zipCode                String?
  isNewsletterSubscriber Boolean                @default(false)
  newsletterVerificationToken String?           @unique
  emailActive            Boolean                @default(true)
  dailyPulses            DailyPulse[]
  journalEntries         JournalEntry[]
  visualProfiles         VisualProfile[]
  spaceMemberships       SpaceMember[]
  posts                  Post[]
  comments               Comment[]
  postLikes              PostLike[]
  lessonProgress         LessonProgress[]
}

model VisualProfile {
  id                String            @id @default(uuid())
  userId            String
  createdAt         DateTime          @default(now())
  openness          Int
  conscientiousness Int
  extraversion      Int
  agreeableness     Int
  neuroticism       Int
  interests         String[]
  cluster           String?
  interactions      UserInteraction[]
  user              User              @relation(fields: [userId], references: [id])
}

model NewsArticle {
  id               String            @id @default(uuid())
  originalUrl      String            @unique
  title            String
  description      String?
  content          String
  imageUrl         String?
  source           String?
  publishedAt      DateTime
  tags             String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reframedArticles ReframedArticle[]
  interactions     UserInteraction[]
}

model ReframedArticle {
  id            String      @id @default(uuid())
  newsArticleId String
  cluster       String
  headline      String
  summary       String
  content       String
  tone          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id])

  @@unique([newsArticleId, cluster])
}

model UserInteraction {
  id            String        @id @default(uuid())
  userId        String
  newsArticleId String
  type          String
  createdAt     DateTime      @default(now())
  newsArticle   NewsArticle   @relation(fields: [newsArticleId], references: [id])
  user          VisualProfile @relation(fields: [userId], references: [id])
}

model DailyPulse {
  id               String   @id @default(uuid())
  userId           String
  createdAt        DateTime @default(now())
  anxiousCalm      Int
  scatteredFocused Int
  drainedEnergized Int
  note             String?
  user             User     @relation(fields: [userId], references: [id])
}

model JournalEntry {
  id         String                 @id @default(uuid())
  userId     String
  createdAt  DateTime               @default(now())
  question   String
  answer     String
  embedding  Unsupported("vector")?
  questionId String?
  user       User                   @relation(fields: [userId], references: [id])
}

model Event {
  id            String                 @id @default(uuid())
  title         String
  description   String
  tags          String[]
  attendeeCount Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  category      String
  latitude      Float?
  longitude     Float?
  rawText       String?
  sourceUrl     String?
  zipCode       String?
  address       String?
  embedding     Unsupported("vector")?
  endTime       DateTime?
  locationName  String?
  source        String                 @default("USER")
  startTime     DateTime
}

model EventSource {
  id               String    @id @default(uuid())
  url              String    @unique
  name             String
  parserType       String
  lastScrapedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastScrapeLog    String?
  lastScrapeStatus String?
  status           String    @default("ACTIVE")
}

model DailySummary {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  content   String
  mood      String?
  createdAt DateTime @default(now())
  cluster   String   @default("Global")

  @@unique([date, cluster])
}

model Newsletter {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  blogS3Url   String?
  htmlContent String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SpaceType {
  FEED
  COURSE
}

enum AccessLevel {
  OPEN
  MEMBER_ONLY
}

enum SpaceRole {
  MEMBER
  ADMIN
  MODERATOR
}

model Space {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  imageUrl    String?
  type        SpaceType   @default(FEED)
  accessLevel AccessLevel @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members     SpaceMember[]
  posts       Post[]
  courses     Course[]
}

model SpaceMember {
  id        String    @id @default(uuid())
  spaceId   String
  userId    String
  role      SpaceRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  space     Space     @relation(fields: [spaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([spaceId, userId])
}

model Post {
  id        String    @id @default(uuid())
  content   String
  spaceId   String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  space     Space     @relation(fields: [spaceId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     PostLike[]
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  postId    String?
  lessonId  String?
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post      Post?     @relation(fields: [postId], references: [id])
  lesson    Lesson?   @relation(fields: [lessonId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@index([lessonId])
}

model Course {
  id          String   @id @default(uuid())
  spaceId     String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space       Space    @relation(fields: [spaceId], references: [id])
  modules     Module[]
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id])
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(uuid())
  moduleId  String
  title     String
  content   String?
  videoUrl  String?
  viewCount Int      @default(0)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module   @relation(fields: [moduleId], references: [id])
  progress  LessonProgress[]
  comments  Comment[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

// ─── Gatherings — recurring group engine ────────────────────────────────────────
// Bounded context. Tables carry a `gatherings_` prefix (via @@map) and live in the
// public schema. user-id fields are OPAQUE host ids (the DB User.id) and have
// DELIBERATELY no relation/FK to User — do not "fix" this; it is what makes the
// engine extractable behind a different auth. See src/lib/gatherings/ARCHITECTURE.md.

model GatheringsGroup {
  id             String          @id @default(uuid())
  name           String
  kind           String          @default("generic") // GroupKind: dinner|sport|boardgames|coffee|generic
  visibility     String          @default("invite_only")
  ownerUserId    String /// opaque host User.id — no relation/FK
  timezone       String // IANA tz, e.g. America/New_York
  scheduleType   String          @default("single") // single | recurring_static | recurring_flexible
  defaultCadence Json
  createdAt      DateTime        @default(now())

  members        GatheringsMember[]
  meetups        GatheringsMeetup[]

  @@map("gatherings_groups")
}

model GatheringsMember {
  id       String       @id @default(uuid())
  groupId  String
  userId   String /// opaque host User.id — no relation/FK
  role     String       @default("member") // owner|co_organizer|member
  status   String       @default("invited") // invited|active|left
  joinedAt DateTime     @default(now())

  group    GatheringsGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, userId])
  @@map("gatherings_members")
}

model GatheringsMeetup {
  id           String        @id @default(uuid())
  groupId      String
  startsAt       DateTime
  locationText   String?
  locationPlaceId String?
  rsvpCutoffAt   DateTime?
  status       String        @default("scheduled") // scheduled|deciding|confirmed|done|cancelled

  group        GatheringsGroup     @relation(fields: [groupId], references: [id])
  rsvps        GatheringsRsvp[]
  reminders    GatheringsReminder[]
  decision     GatheringsDecision?
  photos       GatheringsPhoto[]

  @@unique([groupId, startsAt]) // idempotent meetup generation
  @@map("gatherings_meetups")
}

model GatheringsRsvp {
  id        String        @id @default(uuid())
  meetupId  String
  userId    String /// opaque host User.id — no relation/FK
  state     String        @default("none") // yes|no|maybe|none
  updatedAt DateTime      @updatedAt

  meetup    GatheringsMeetup @relation(fields: [meetupId], references: [id])

  @@unique([meetupId, userId]) // one rsvp row per user per meetup
  @@map("gatherings_rsvps")
}

model GatheringsReminder {
  id       String        @id @default(uuid())
  meetupId String
  userId   String /// opaque host User.id — no relation/FK
  kind     String // pre_meetup | rsvp_cutoff
  sentAt   DateTime      @default(now())

  meetup   GatheringsMeetup @relation(fields: [meetupId], references: [id])

  @@unique([meetupId, userId, kind]) // send-once idempotency
  @@map("gatherings_reminders")
}

model GatheringsDecision {
  id               String        @id @default(uuid())
  meetupId         String        @unique // one decision per meetup (v1)
  type             String // venue_vote | host_pick | none
  options          Json // [{ id, label, meta? }]
  status           String        @default("open") // open | resolved | cancelled
  closesAt         DateTime
  resolvedOptionId String?
  createdAt        DateTime      @default(now())

  meetup           GatheringsMeetup @relation(fields: [meetupId], references: [id])
  votes            GatheringsVote[]

  @@map("gatherings_decisions")
}

model GatheringsVote {
  id         String          @id @default(uuid())
  decisionId String
  userId     String /// opaque host User.id — no relation/FK
  optionId   String
  updatedAt  DateTime        @updatedAt

  decision   GatheringsDecision @relation(fields: [decisionId], references: [id])

  @@unique([decisionId, userId]) // one vote per user
  @@map("gatherings_votes")
}

model GatheringsPhoto {
  id            String        @id @default(uuid())
  meetupId      String
  addedByUserId String /// opaque host User.id — no relation/FK
  url           String // a reference; the host owns the actual upload (S3)
  caption       String?
  createdAt     DateTime      @default(now())

  meetup        GatheringsMeetup @relation(fields: [meetupId], references: [id])

  @@map("gatherings_photos")
}
