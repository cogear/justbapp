generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  displayName            String?
  isPhantom              Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  psychographicProfile   String?
  memoryVector           Unsupported("vector")?
  zipCode                String?
  isNewsletterSubscriber Boolean                @default(false)
  newsletterVerificationToken String?           @unique
  emailActive            Boolean                @default(true)
  dailyPulses            DailyPulse[]
  journalEntries         JournalEntry[]
  visualProfiles         VisualProfile[]
  spaceMemberships       SpaceMember[]
  posts                  Post[]
  comments               Comment[]
  lessonProgress         LessonProgress[]
}

model VisualProfile {
  id                String            @id @default(uuid())
  userId            String
  createdAt         DateTime          @default(now())
  openness          Int
  conscientiousness Int
  extraversion      Int
  agreeableness     Int
  neuroticism       Int
  interests         String[]
  cluster           String?
  interactions      UserInteraction[]
  user              User              @relation(fields: [userId], references: [id])
}

model NewsArticle {
  id               String            @id @default(uuid())
  originalUrl      String            @unique
  title            String
  description      String?
  content          String
  imageUrl         String?
  source           String?
  publishedAt      DateTime
  tags             String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reframedArticles ReframedArticle[]
  interactions     UserInteraction[]
}

model ReframedArticle {
  id            String      @id @default(uuid())
  newsArticleId String
  cluster       String
  headline      String
  summary       String
  content       String
  tone          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id])

  @@unique([newsArticleId, cluster])
}

model UserInteraction {
  id            String        @id @default(uuid())
  userId        String
  newsArticleId String
  type          String
  createdAt     DateTime      @default(now())
  newsArticle   NewsArticle   @relation(fields: [newsArticleId], references: [id])
  user          VisualProfile @relation(fields: [userId], references: [id])
}

model DailyPulse {
  id               String   @id @default(uuid())
  userId           String
  createdAt        DateTime @default(now())
  anxiousCalm      Int
  scatteredFocused Int
  drainedEnergized Int
  note             String?
  user             User     @relation(fields: [userId], references: [id])
}

model JournalEntry {
  id         String                 @id @default(uuid())
  userId     String
  createdAt  DateTime               @default(now())
  question   String
  answer     String
  embedding  Unsupported("vector")?
  questionId String?
  user       User                   @relation(fields: [userId], references: [id])
}

model Event {
  id            String                 @id @default(uuid())
  title         String
  description   String
  tags          String[]
  attendeeCount Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  category      String
  latitude      Float?
  longitude     Float?
  rawText       String?
  sourceUrl     String?
  zipCode       String?
  address       String?
  embedding     Unsupported("vector")?
  endTime       DateTime?
  locationName  String?
  source        String                 @default("USER")
  startTime     DateTime
}

model EventSource {
  id               String    @id @default(uuid())
  url              String    @unique
  name             String
  parserType       String
  lastScrapedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastScrapeLog    String?
  lastScrapeStatus String?
  status           String    @default("ACTIVE")
}

model DailySummary {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  content   String
  mood      String?
  createdAt DateTime @default(now())
  cluster   String   @default("Global")

  @@unique([date, cluster])
}

model Newsletter {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  blogS3Url   String?
  htmlContent String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SpaceType {
  FEED
  COURSE
}

enum AccessLevel {
  OPEN
  MEMBER_ONLY
}

enum SpaceRole {
  MEMBER
  ADMIN
  MODERATOR
}

model Space {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  imageUrl    String?
  type        SpaceType   @default(FEED)
  accessLevel AccessLevel @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members     SpaceMember[]
  posts       Post[]
  courses     Course[]
}

model SpaceMember {
  id        String    @id @default(uuid())
  spaceId   String
  userId    String
  role      SpaceRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  space     Space     @relation(fields: [spaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([spaceId, userId])
}

model Post {
  id        String    @id @default(uuid())
  content   String
  spaceId   String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  space     Space     @relation(fields: [spaceId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post      Post      @relation(fields: [postId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
}

model Course {
  id          String   @id @default(uuid())
  spaceId     String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space       Space    @relation(fields: [spaceId], references: [id])
  modules     Module[]
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id])
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(uuid())
  moduleId  String
  title     String
  content   String?
  videoUrl  String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module   @relation(fields: [moduleId], references: [id])
  progress  LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}
